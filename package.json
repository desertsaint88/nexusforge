{
  "name": "nexusforge",
  "productName": "NexusForge",
  "version": "1.5.0",
  "description": "Universal game mod manager & launcher",
  "author": "NexusForge",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "postinstall": "install-electron",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "extract-zip": "^2.0.1"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "latest",
    "@fontsource-variable/jetbrains-mono": "latest",
    "@hello-pangea/dnd": "^18.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "framer-motion": "^14.6.0",
    "lucide-react": "latest",
    "playwright-core": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zustand": "^5.0.16"
  }
}
